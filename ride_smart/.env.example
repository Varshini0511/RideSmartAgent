# RideSmartAgent Configuration
# Copy to .env and fill in your values

# Price threshold: switch from cab to auto if cheapest cab exceeds this (INR)
CAB_PRICE_THRESHOLD=380

# Booking timeout in seconds (how long to wait before trying next option)
BOOKING_TIMEOUT=120

# Seconds to wait for price quotes from each provider
QUOTE_TIMEOUT=30

# Max booking attempts before giving up
MAX_BOOKING_ATTEMPTS=4

# Browser mode: false = visible browser (see what's happening), true = headless
HEADLESS_BROWSER=false

# Browser type: chromium, firefox, or webkit
BROWSER_TYPE=chromium

# Directory to store persistent login sessions
USER_DATA_DIR=browser_sessions

# Google Maps API key (optional, for better geocoding)
# Get one at: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Default city for geocoding
DEFAULT_CITY=Bengaluru

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
